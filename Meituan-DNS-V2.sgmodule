#!name=Meituan DNS V2
#!desc=仅公司域名执行 JSC 网络判断；国内列表原生解析，其余使用主配置默认 DNS。

[Host]
*.local = server:system

# 公司清单统一维护在 meituan_dns.list；命中后由脚本判断网络。
RULE-SET:https://raw.githubusercontent.com/afsfge/surge/main/meituan_dns.list = script:meituan-company-dns-v2

*.apple.com.cn = server:119.29.29.29
*.icloud.com = server:119.29.29.29
*.weixin.com = server:119.29.29.29
*.tencent.com = server:119.29.29.29
*.apple.com = server:119.29.29.29

RULE-SET:https://raw.githubusercontent.com/Loyalsoldier/surge-rules/release/ruleset/direct.txt = server:223.6.6.6,119.29.29.29

[Script]
meituan-company-dns-v2 = type=dns,engine=jsc,script-path=https://raw.githubusercontent.com/afsfge/surge/main/scripts/meituan-company-dns-v2.js
