#!name=Meituan DNS 精简版
#!desc=Meituan Wi-Fi 下公司域名使用内网 DNS；其余按国内列表或主配置默认 DNS 解析。

[Host]
# 固定 IP、别名及其他必须保留的 Host 映射应放在下面两条脚本入口之前。
*.local = server:system

# 高频域名直接使用国内 DNS，不经过脚本，也不区分网络。
*.apple.com.cn = server:119.29.29.29
*.icloud.com = server:119.29.29.29
*.weixin.com = server:119.29.29.29
*.tencent.com = server:119.29.29.29
*.apple.com = server:119.29.29.29

RULE-SET:https://raw.githubusercontent.com/Loyalsoldier/surge-rules/release/ruleset/direct.txt = script:meituan-dns-domestic
* = script:meituan-dns-default

[Script]
meituan-dns-domestic = type=dns,engine=jsc,script-path=https://raw.githubusercontent.com/afsfge/surge/main/scripts/meituan-dns-simple.js,argument=domestic
meituan-dns-default = type=dns,engine=jsc,script-path=https://raw.githubusercontent.com/afsfge/surge/main/scripts/meituan-dns-simple.js,argument=default
